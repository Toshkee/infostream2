# Copy to .env.local and fill in. .env.local is gitignored.
# Google AI Studio (Gemini) API key — https://aistudio.google.com/apikey
# Standard keys look like "AIzaSy...". Server-only; never expose to the client.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Set to 0 to remove the chat widget and refuse /api/chat (kill switch).
# ASSISTANT_ENABLED=1

# Optional. Set to 1 ONLY when a reverse proxy you control sets x-real-ip and
# strips any incoming value (nginx: proxy_set_header X-Real-IP $remote_addr;),
# or on a platform that does it for you, such as Vercel. It turns on per-IP
# rate limiting for /api/chat. Left unset, the route does not bucket per IP at
# all, because a forgeable header would hand an abuser a fresh budget on every
# request; only the aggregate ceiling applies. See "Hosting handover" in
# README.md.
# TRUSTED_PROXY=1

# Optional. Set to 1 to surface upstream Gemini error detail to the client
# (debugging only — never enable in production).
# CHAT_DEBUG=1
