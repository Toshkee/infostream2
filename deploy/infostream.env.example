# Production environment. Copy to /etc/infostream.env on the VPS, then
#   sudo chown root:infostream /etc/infostream.env && sudo chmod 640 /etc/infostream.env
# Read by systemd at runtime AND by deploy.sh at build time
# (ASSISTANT_ENABLED is baked in by the build).

# A production-only Gemini key with a spending cap set in Google AI Studio.
GEMINI_API_KEY=

# nginx sets X-Real-IP itself (deploy/nginx.conf), so per-IP limits are safe.
TRUSTED_PROXY=1

# Set to 0 to launch without the assistant. Requires a redeploy.
ASSISTANT_ENABLED=1
