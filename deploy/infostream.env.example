# Production environment. Copy to /etc/infostream.env on the VPS, then
#   sudo chown root:infostream /etc/infostream.env && sudo chmod 640 /etc/infostream.env
# Read by systemd at runtime AND by deploy.sh at build time
# (ASSISTANT_ENABLED is baked in by the build).

# A production-only Gemini key. Set a HARD budget cap on it in Google Cloud
# Billing (see docs/handover.md) — the app's own limits are best-effort and
# reset whenever the process restarts.
GEMINI_API_KEY=

# Ceiling on upstream Gemini calls per UTC day, per process. Defaults to 1500,
# which is far above what this site's real visitors produce. Lower it to make
# the assistant cheaper to run; raise it only with the billing cap in place.
CHAT_DAILY_MAX=1500

# nginx sets X-Real-IP itself (deploy/nginx.conf), so per-IP limits are safe.
TRUSTED_PROXY=1

# Set to 0 to launch without the assistant. Requires a redeploy.
ASSISTANT_ENABLED=1
